{
  "name": "react-native-liquid-glassmorphism",
  "version": "1.2.1",
  "description": "Liquid Glass for React Native on Android AND iOS \u2014 not an iOS-only wrapper. Apple's native UIGlassEffect on iOS 26, real-time AGSL refraction shader on Android 13+, from one <LiquidGlassView>. Glassmorphism, frosted glass, glass blur, custom shapes. Expo config plugin, New Architecture, TypeScript.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "llms.txt",
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "app.plugin.js",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-liquid-glassmorphism-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"plugin/**/*.{ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "build": "bob build",
    "validate": "yarn lint && yarn typecheck && yarn test && yarn build",
    "release": "release-it --only-version",
    "example:start": "npm --prefix example start",
    "example:ios": "npm --prefix example run ios",
    "example:android": "npm --prefix example run android",
    "example:web": "npm --prefix example run web"
  },
  "keywords": [
    "react-native",
    "liquid-glass",
    "liquid-glass-android",
    "android-liquid-glass",
    "liquid-glass-view",
    "liquid-glassmorphism",
    "glassmorphism",
    "glass-morphism",
    "glassmorphism-android",
    "ios-26",
    "ios26",
    "ios26-glass",
    "ios-liquid-glass",
    "apple-glass",
    "uiglasseffect",
    "runtimeshader",
    "glass-view",
    "glass-blur",
    "blur-background",
    "blurview",
    "glass-tab-bar",
    "frosted-glass-view",
    "glass-effect",
    "frosted-glass",
    "blur",
    "blur-view",
    "backdrop-blur",
    "backdrop-filter",
    "expo-blur-alternative",
    "refraction",
    "chromatic-aberration",
    "chromatic-dispersion",
    "iridescence",
    "sdf",
    "scroll-edge-blur",
    "shader",
    "runtime-shader",
    "rendereffect",
    "agsl",
    "expo-glass-effect-alternative",
    "glass",
    "glass-ui",
    "glass-card",
    "translucent",
    "frosted",
    "vibrancy",
    "ios",
    "android",
    "cross-platform",
    "expo",
    "expo-config-plugin",
    "new-architecture",
    "fabric",
    "turbomodules",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshu-lal4/react-native-liquid-glassmorphism.git"
  },
  "author": "Himanshu Lal <himanshulal56@gmail.com> (https://github.com/himanshu-lal4)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/himanshu-lal4/react-native-liquid-glassmorphism/issues"
  },
  "homepage": "https://himanshu-lal4.github.io/react-native-liquid-glassmorphism/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@react-native/babel-preset": "0.83.6",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-builder-bob": "^0.43.0",
    "release-it": "^19.0.4",
    "turbo": "^2.10.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.83.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "chore",
          "ci",
          "revert"
        ]
      ],
      "subject-case": [
        0
      ],
      "body-max-line-length": [
        0
      ],
      "header-max-length": [
        0
      ]
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "_comment": "Publishing happens in CI (.github/workflows/publish-npm.yml) so the release gets npm provenance. Provenance can only be generated from CI, and a local publish would also consume the version number the workflow needs. Do not set this back to true.",
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": "./.prettierrc.js",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "LiquidGlassmorphismViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.liquidglassmorphism"
    },
    "ios": {
      "components": {
        "LiquidGlassmorphismView": {
          "className": "LiquidGlassmorphismView"
        },
        "ScrollEdgeBlurView": {
          "className": "ScrollEdgeBlurView"
        },
        "LiquidGlassContainer": {
          "className": "LiquidGlassContainer"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "version": "0.63.0"
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "example/"
  ]
}
